// Prisma Schema for Mini Shop Next.js
// Giúp tự động đồng bộ thực thể từ Code lên PostgreSQL/Supabase Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id
  name      String
  count     Int       @default(0)
  icon      String?
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id            BigInt    @id
  name          String
  categoryId    String?   @map("category")
  categoryName  String    @map("category_name")
  price         Decimal
  originalPrice Decimal?  @map("original_price")
  image         String
  gallery       String[]  @default([])
  rating        Decimal   @default(5.0)
  reviewsCount  Int       @default(0) @map("reviews_count")
  shortDesc     String?   @map("short_desc")
  description   String?
  stock         Int       @default(0)
  isFeatured    Boolean   @default(false) @map("is_featured")
  isNew         Boolean   @default(false) @map("is_new")
  badge         String?
  specs         Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews       Review[]

  @@map("products")
}

model Order {
  id             String   @id
  userId         String?  @map("user_id")
  customerName   String   @map("customer_name")
  phone          String
  email          String?
  address        String
  note           String?
  items          Json     @default("[]")
  totalAmount    Decimal  @map("total_amount")
  shippingFee    Decimal  @default(0) @map("shipping_fee")
  discountAmount Decimal  @default(0) @map("discount_amount")
  couponCode     String?  @map("coupon_code")
  status         String   @default("PROCESSING")
  statusText     String   @default("Đang xử lý") @map("status_text")
  paymentMethod  String   @default("COD") @map("payment_method")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("orders")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Review {
  id        String   @id @default(uuid())
  productId BigInt   @map("product_id")
  userName  String   @map("user_name")
  userEmail String?  @map("user_email")
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Coupon {
  code            String   @id
  discountPercent Decimal  @default(0) @map("discount_percent")
  maxDiscount     Decimal? @map("max_discount")
  minOrderValue   Decimal? @map("min_order_value")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("coupons")
}
